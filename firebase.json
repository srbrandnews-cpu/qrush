{
  "apphosting": {
    "backend": {
      "region": "asia-south1",
      "rootDir": "."
    }
  },
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "tablenest",
          "region": "asia-south1"
        }
      }
    ]
  }
}
