{
  "name": "tablenest",
  "version": "1.0.0",
  "description": "QRush - Free Digital QR Menu Generator for restaurants. Owners create a hosted QR menu, take orders, and manage upgrades; the platform console handles plans, payments and ads.",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "build": "node -e \"process.exit(0)\"",
    "test": "node scripts/smoke-test.js",
    "check:syntax": "node scripts/check-syntax.js",
    "verify": "npm run check:syntax && npm test && npm audit --omit=dev",
    "predeploy": "node scripts/predeploy.js",
    "tunnel": "node scripts/start-tunnel.js",
    "setup:domain": "node scripts/setup-domain.js",
    "dev": "nodemon server.js",
    "test:superadmin": "node scripts/test-superadmin.js",
    "pg:check": "node scripts/pg-check.js",
    "cleanup:tenants": "node scripts/cleanup-test-tenants.js",
    "db:migrate": "node scripts/sqlite-to-postgres.js",
    "backup:db": "node scripts/backup-db.js",
    "restore:db": "node scripts/restore-db.js",
    "backup:chat": "node scripts/backup-chat.js",
    "fix:heic": "node scripts/fix-heic-menus.js",
    "test:migrate": "node scripts/test-migrate.js",
    "icons": "node scripts/make-icon.js"
  },
  "keywords": [
    "restaurant",
    "qr-ordering",
    "kds",
    "saas",
    "table-ordering"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "csv-parse": "^7.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "heic-convert": "^1.2.4",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "embedded-postgres": "^18.4.0-beta.17",
    "nodemon": "^3.1.7"
  }
}
