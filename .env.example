# --- Server ---
PORT=3000

# Public URL a phone reaches this server on. Used to build the QR codes.
# Local demo:  http://localhost:3000
# On your LAN: http://192.168.1.5:3000   (phones on the same WiFi can scan)
# In prod:     https://order.yourhotel.com
BASE_URL=http://localhost:3000

# --- Public tunnel / domain ---
# QUICK mode (free, no account): TUNNEL_TOKEN khaali chhod dein.
#   -> random https://xxx.trycloudflare.com, har restart par badal jaata hai.
#
# NAMED mode (recommended — permanent URL):
#   Cloudflare Zero Trust -> Tunnels -> Create -> token copy karke yahan paste
#   karein, aur apna hostname daalein. Guide: docs/DOMAIN-SETUP.md
TUNNEL_TOKEN=
PUBLIC_HOSTNAME=

# --- Security ---
# CHANGE THIS to a long random string in production. Used to sign login tokens.
JWT_SECRET=change-me-to-a-long-random-string

# --- Web push (optional) ---
# Notifications sirf browser push (web push) par jaate hain — koi SMS/WhatsApp
# provider nahi chahiye. Keys pehli baar server chalne par khud generate ho kar
# data/vapid.json mein save ho jaati hain.
VAPID_SUBJECT=mailto:support@yourhotel.com
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# --- WhatsApp / SMS notifications ---
# --- Database ---
# DB_CLIENT decides the driver. Both expose the same API, so the app code is
# identical either way.
#
#   sqlite    (default) — zero setup, single file, great for dev & small installs
#   postgres  (production) — connection pooling, handles many restaurants
#
DB_CLIENT=sqlite

# SQLite only
# DB_DIR=data
# DB_FILE=data/tablenest.db

# Postgres only (used when DB_CLIENT=postgres).
# Either set DATABASE_URL ...
# DATABASE_URL=postgresql://user:password@host:5432/tablenest
# ... or the individual parts:
# PGHOST=127.0.0.1
# PGPORT=5432
# PGUSER=tablenest
# PGPASSWORD=your-password
# PGDATABASE=tablenest
# PGPOOL_MAX=10
